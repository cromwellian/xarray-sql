@@ -0,0 +1,261 @@
+"""Prove a complete-domain RMS normalization from numerical operations."""
+
+from dataclasses import dataclass
+from fractions import Fraction
+
+import numpy as np
+
+from ._dense_attention import (
+    _bind_reduction,
+    _bound_same,
+    _factors,
+    _scalar,
+    _static_mask,
+    _View,
+    _view,
+)
+
+
+@dataclass(frozen=True)
+class _Normalization:
+    value: object
+    feature: object
+    eps: float
+    output: tuple
+
+
+def _match(tensor):
+    root = _view(tensor)
+    if root.node.kind != "/":
+        return None
+    value, denominator = root.args()
+    if denominator.node.kind != "sqrt":
+        return None
+    addition = denominator.args()[0]
+    if addition.node.kind != "+":
+        return None
+    for average, epsilon in [addition.args(), addition.args()[::-1]]:
+        eps = _scalar(epsilon)
+        if (
+            eps is None
+            or not 0 < eps <= np.finfo(np.float32).max
+            or average.node.kind != "/"
+        ):
+            continue
+        total, count = average.args()
+        info = total.node.reduction
+        if info is None or info.kind != "sum" or info.repeated != 1:
+            continue
+        feature = tuple(a for a in value.axes() if a not in denominator.axes())
+        if len(feature) != 1 or _scalar(count) != len(feature[0]):
+            continue
+        mapping = _bind_reduction(total, feature)
+        if mapping is None:
+            continue
+        bound = _View(total.node, tuple(mapping.items()))
+        mask = _static_mask(bound.child(info.mask), value.axes())
+        factors = _factors(bound.child(info.value))
+        if mask is None or not np.all(mask) or len(factors) != 2:
+            continue
+        if set(bound.axes(info.row_axes)) != set(value.axes()) or set(
+            bound.axes(info.kept)
+        ) != set(denominator.axes()):
+            continue
+        if all(
+            _bound_same(factor, value, denominator.axes()) for factor in factors
+        ):
+            return _Normalization(value, feature[0], eps, root.axes())
+    return None
+
+
+def _full(view, info):
+    mask = _static_mask(view.child(info.mask), view.axes(info.row_axes))
+    return mask is not None and np.all(mask)
+
+
+def _strip(view):
+    for _ in range(16):
+        info = view.node.reduction
+        if view.node.kind == "float64":
+            view = view.args()[0]
+        elif (
+            info is not None
+            and info.kind == "sum"
+            and info.repeated == 1
+            and set(info.row_axes) == set(info.kept)
+            and _full(view, info)
+        ):
+            view = view.child(info.value)
+        else:
+            break
+    return view
+
+
+def _multiply(left, right):
+    if left is None or right is None or len(left) * len(right) > 16:
+        return None
+    result = {}
+    for a, ca in left.items():
+        for b, cb in right.items():
+            powers = dict(a)
+            for atom, power in b:
+                powers[atom] = powers.get(atom, 0) + power
+            key = frozenset(
+                (atom, power) for atom, power in powers.items() if power
+            )
+            result[key] = result.get(key, Fraction(0)) + ca * cb
+    return {k: v for k, v in result.items() if v}
+
+
+def _monomial(**powers):
+    return frozenset((atom, power) for atom, power in powers.items() if power)
+
+
+class _Derivative:
+    def __init__(self, value, dy, denominator, feature, kept):
+        self.symbols = [(value, "x"), (dy, "d"), (denominator, "s")]
+        self.feature, self.kept = feature, kept
+        self.remaining = 256
+
+    def run(self, view):
+        self.remaining -= 1
+        if self.remaining < 0:
+            return None
+        view = _strip(view)
+        for source, atom in self.symbols:
+            if _bound_same(view, source, self.kept):
+                return {_monomial(**{atom: 1}): Fraction(1)}
+        scalar = _scalar(view)
+        if scalar is not None:
+            return {_monomial(): Fraction(scalar)} if scalar else {}
+        args = view.args()
+        kind = view.node.kind
+        if kind in {"+", "-"}:
+            left, right = (self.run(a) for a in args)
+            if left is None or right is None:
+                return None
+            result = dict(left)
+            for k, c in right.items():
+                result[k] = result.get(k, Fraction(0)) + (
+                    c if kind == "+" else -c
+                )
+            return {k: c for k, c in result.items() if c}
+        if kind == "neg":
+            child = self.run(args[0])
+            return None if child is None else {k: -c for k, c in child.items()}
+        if kind in {"*", "/"}:
+            left, right = (self.run(a) for a in args)
+            if kind == "/":
+                if right is None or len(right) != 1:
+                    return None
+                key, c = next(iter(right.items()))
+                if not c:
+                    return None
+                right = {frozenset((a, -p) for a, p in key): 1 / c}
+            return _multiply(left, right)
+        info = view.node.reduction
+        if (
+            info is None
+            or info.kind != "sum"
+            or info.repeated != 1
+            or not _full(view, info)
+        ):
+            return None
+        if set(view.axes(info.kept)) != set(self.kept):
+            return None
+        mapping = _bind_reduction(view, (self.feature,))
+        if mapping is None:
+            return None
+        bound = _View(view.node, tuple(mapping.items()))
+        inner = self.run(bound.child(info.value))
+        if inner is None:
+            return None
+        result = {}
+        for key, c in inner.items():
+            p = dict(key)
+            if p.pop("x", 0) != 1 or p.pop("d", 0) != 1:
+                return None
+            p["r"] = 1
+            result[frozenset(p.items())] = c
+        return result
+
+
+@dataclass(frozen=True)
+class _Gradient:
+    normalization: _Normalization
+    dy: object
+
+
+def _gradient(left, right, axes):
+    """Prove d/s - x*SUM(x*d)/(N*s^3), independent of SQL names."""
+    left_view = _view(left.value, dict(zip(left.axes, axes)).items())
+    right_view = _view(right.value, dict(zip(right.axes, axes)).items())
+    first = _strip(left_view)
+    factors = _factors(first)
+    candidates = []
+    if first.node.kind == "/":
+        candidates.append(first.args())
+    if len(factors) == 2:
+        for dy, inverse in [factors, factors[::-1]]:
+            if inverse.node.kind == "/" and _scalar(inverse.args()[0]) == 1:
+                candidates.append((dy, inverse.args()[1]))
+    for dy, denominator in candidates:
+        # Construct the same quotient descriptor used by the forward proof.
+        if denominator.node.kind != "sqrt":
+            continue
+        addition = denominator.args()[0]
+        if addition.node.kind != "+":
+            continue
+        for average, epsilon in [addition.args(), addition.args()[::-1]]:
+            if average.node.kind != "/":
+                continue
+            total, count = average.args()
+            info = total.node.reduction
+            if info is None or info.kind != "sum":
+                continue
+            feature = tuple(a for a in axes if a not in denominator.axes())
+            if len(feature) != 1 or _scalar(count) != len(feature[0]):
+                continue
+            mapping = _bind_reduction(total, feature)
+            if mapping is None:
+                continue
+            bound = _View(total.node, tuple(mapping.items()))
+            squared = _factors(bound.child(info.value))
+            eps = _scalar(epsilon)
+            if (
+                len(squared) != 2
+                or eps is None
+                or not 0 < eps <= np.finfo(np.float32).max
+                or not _full(bound, info)
+            ):
+                continue
+            value = squared[0]
+            if not _bound_same(squared[1], value, denominator.axes()):
+                continue
+            if set(value.axes()) != set(axes):
+                continue
+            kept = denominator.axes()
+            masks = [
+                _static_mask(
+                    _view(part.mask, dict(zip(part.axes, axes)).items()), axes
+                )
+                for part in [left, right]
+            ]
+            if any(m is None or not np.all(m) for m in masks):
+                continue
+            proof = _Derivative(value, dy, denominator, feature[0], kept)
+            a, b = proof.run(left_view), proof.run(right_view)
+            if a is None or b is None:
+                continue
+            for key, c in b.items():
+                a[key] = a.get(key, Fraction(0)) + c
+            a = {k: c for k, c in a.items() if c}
+            expected = {
+                _monomial(d=1, s=-1): Fraction(1),
+                _monomial(x=1, r=1, s=-3): Fraction(-1, len(feature[0])),
+            }
+            if a == expected:
+                return _Gradient(
+                    _Normalization(value, feature[0], eps, tuple(axes)), dy
+                )
+    return None
