+"""Normalization and class-loss kernels preserve SQL and ddx results."""
+
+import os
+
+import numpy as np
+import pytest
+import xarray as xr
+
+from xarray_sql import Context
+from xarray_sql.training import TrainingSession
+
+pytest.importorskip("einfold.dense_program")
+pytest.importorskip("ddxdb")
+pytestmark = pytest.mark.skipif(
+    os.environ.get("MLX_ENABLE_TF32") != "0", reason="requires MLX GPU"
+)
+
+
+@pytest.mark.parametrize("operation", ["rms", "cross_entropy", "logsumexp"])
+@pytest.mark.parametrize("case", ["dense", "nullable", "filtered"])
+def test_primitives_and_ddx_gradients_preserve_masks_and_inputs(
+    monkeypatch, operation, case
+):
+    monkeypatch.setenv("EINFOLD_DENSE_SYMBOLIC_MASKS", "1")
+    rng = np.random.default_rng(25)
+    coordinates = np.arange(64) * 2 - 3
+    data = rng.normal(size=(2, 64))
+    column = (
+        "CASE WHEN k=1 THEN NULL ELSE val END" if case == "nullable" else "val"
+    )
+    where = " WHERE k<>1" if case == "filtered" else ""
+    prefix = f"values_table AS (SELECT b,k,{column} AS v FROM x{where}),"
+    if operation == "rms":
+        prefix += """magnitude AS (SELECT b,sqrt(AVG(v*v)+1e-5) AS n FROM values_table GROUP BY b),
+        normalized AS (SELECT x.b,x.k,x.v/n.n AS z FROM values_table x JOIN magnitude n ON x.b=n.b),
+        loss AS (SELECT SUM(z*z) AS l FROM normalized)"""
+    else:
+        prefix += """maximum AS (SELECT b,ddx_stop_gradient(MAX(v)) AS m FROM values_table GROUP BY b),
+        lse AS (SELECT x.b,MAX(m.m)+ln(SUM(exp(x.v-m.m))) AS z FROM values_table x JOIN maximum m ON x.b=m.b GROUP BY x.b),
+        loss AS (SELECT AVG(s.z-x.v) AS l FROM lse s JOIN targets t ON s.b=t.b JOIN values_table x ON x.b=t.b AND x.k=t.tok)"""
+        if operation == "logsumexp":
+            prefix = (
+                prefix[: prefix.index("loss AS (")]
+                + "loss AS (SELECT AVG(z) AS l FROM lse)"
+            )
+    expected = []
+    for enabled in [False, True]:
+        monkeypatch.setenv("XQL_MLX_NORMALIZATION", str(int(enabled)))
+        monkeypatch.setenv("XQL_MLX_NORMALIZATION_BACKWARD", str(int(enabled)))
+        monkeypatch.setenv("XQL_MLX_CROSS_ENTROPY", str(int(enabled)))
+        monkeypatch.setenv("XQL_MLX_SOFTMAX", str(int(enabled)))
+        session = TrainingSession(Context())
+        try:
+            session.bind(
+                "x",
+                xr.Dataset(
+                    {"val": (("b", "k"), data)},
+                    coords={"b": np.arange(2), "k": coordinates},
+                ),
+            )
+            session.bind(
+                "targets",
+                xr.Dataset(
+                    {"tok": ("b", coordinates[[3, 5]])},
+                    coords={"b": np.arange(2)},
+                ),
+            )
+            session.index_domains("targets", {"tok": ("x", "k")})
+            step = session.prepare_step(
+                gradients={
+                    "gx": f"WITH {prefix} SELECT b,k,grad(loss,val) AS g FROM x ORDER BY b,k"
+                },
+                stages={},
+                updates={},
+                assignments={},
+                compile=True,
+                validation="full",
+            )
+            for iteration in range(2):
+                session.bind(
+                    "x",
+                    xr.Dataset(
+                        {"val": (("b", "k"), data * (1 - iteration * 0.02))},
+                        coords={"b": np.arange(2), "k": coordinates},
+                    ),
+                )
+                session.bind(
+                    "targets",
+                    xr.Dataset(
+                        {
+                            "tok": (
+                                "b",
+                                coordinates[[3 + iteration, 5 + iteration]],
+                            )
+                        }
+                    ),
+                )
+                result = step()
+                rows = result.export("gx")["gx"]
+                loss = result.loss_value()
+                if not enabled:
+                    expected.append((loss, rows))
+                else:
+                    want_loss, want = expected[iteration]
+                    np.testing.assert_allclose(
+                        loss, want_loss, atol=3e-5, rtol=3e-5
+                    )
+                    assert rows.schema == want.schema
+                    assert rows["b"].to_pylist() == want["b"].to_pylist()
+                    assert rows["k"].to_pylist() == want["k"].to_pylist()
+                    assert (
+                        rows["g"].is_null().to_pylist()
+                        == want["g"].is_null().to_pylist()
+                    )
+                    np.testing.assert_allclose(
+                        rows["g"].to_numpy(),
+                        want["g"].to_numpy(),
+                        atol=3e-5,
+                        rtol=3e-5,
+                        equal_nan=True,
+                    )
+        finally:
+            session.close()
