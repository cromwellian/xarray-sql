@@ -0,0 +1,168 @@
+"""Prove complete-domain logsumexp minus a positional target lookup."""
+
+from dataclasses import dataclass
+
+import numpy as np
+
+from ._dense_attention import (
+    _bind_reduction,
+    _bound_same,
+    _factors,
+    _scalar,
+    _static_mask,
+    _View,
+    _view,
+)
+from ._dense_normalization import _strip
+
+
+@dataclass(frozen=True)
+class _CrossEntropy:
+    logits: object
+    indexes: object
+    index_axes: tuple
+    feature: object
+    output: tuple
+
+
+@dataclass(frozen=True)
+class _SoftmaxGradient:
+    logits: object
+    weight: object
+    feature: object
+    output: tuple
+
+
+def _softmax_gradient(tensor):
+    """Prove exp(x-max)/SUM(exp(x-max)) times a class-independent weight."""
+    root = _view(tensor)
+    factors = _factors(root)
+    if len(factors) != 2:
+        return None
+    for exponential, coefficient in [factors, factors[::-1]]:
+        if exponential.node.kind != "exp":
+            continue
+        coefficient = _strip(coefficient)
+        candidates = []
+        if coefficient.node.kind == "/":
+            candidates.append(coefficient.args())
+        cf = _factors(coefficient)
+        if len(cf) == 2:
+            for weight, inverse in [cf, cf[::-1]]:
+                if inverse.node.kind == "/" and _scalar(inverse.args()[0]) == 1:
+                    candidates.append((weight, inverse.args()[1]))
+        for weight, total in candidates:
+            info = total.node.reduction
+            if info is None or info.kind != "sum" or info.repeated != 1:
+                continue
+            feature = tuple(
+                a for a in exponential.axes() if a not in total.axes()
+            )
+            if len(feature) != 1 or not set(weight.axes()).issubset(
+                total.axes()
+            ):
+                continue
+            mapping = _bind_reduction(total, feature)
+            if mapping is None:
+                continue
+            bound = _View(total.node, tuple(mapping.items()))
+            if not _bound_same(
+                bound.child(info.value), exponential, total.axes()
+            ) or not _all_rows(bound, info, exponential.axes()):
+                continue
+            difference = exponential.args()[0]
+            if difference.node.kind != "-":
+                continue
+            logits, maximum = difference.args()
+            extreme = maximum.node.reduction
+            if extreme is None or extreme.kind != "max":
+                continue
+            mapping = _bind_reduction(maximum, feature)
+            if mapping is None:
+                continue
+            maximum = _View(maximum.node, tuple(mapping.items()))
+            if not _bound_same(
+                maximum.child(extreme.value), logits, total.axes()
+            ) or not _all_rows(maximum, extreme, logits.axes()):
+                continue
+            if set(bound.axes(info.row_axes)) != set(logits.axes()) or set(
+                bound.axes(info.kept)
+            ) != set(total.axes()):
+                continue
+            return _SoftmaxGradient(logits, weight, feature[0], root.axes())
+    return None
+
+
+def _all_rows(view, info, axes):
+    mask = _static_mask(view.child(info.mask), axes)
+    return mask is not None and np.all(mask)
+
+
+def _match(tensor):
+    root = _view(tensor)
+    if root.node.kind != "-":
+        return None
+    lse, target = root.args()
+    if target.node.kind != "take" or lse.node.kind != "+":
+        return None
+    source, indexes, _, replacement = target.node.value
+    logits = target.child(target.node.args[0])
+    feature = logits.axes((source,))[0]
+    rows = tuple(a for a in logits.axes() if a is not feature)
+    if set(root.axes()) != set(rows) or set(target.axes(replacement)) != set(
+        rows
+    ):
+        return None
+    for maximum, logarithm in [lse.args(), lse.args()[::-1]]:
+        if logarithm.node.kind != "ln":
+            continue
+        total = logarithm.args()[0]
+        info = total.node.reduction
+        if info is None or info.kind != "sum" or info.repeated != 1:
+            continue
+        mapping = _bind_reduction(total, (feature,))
+        if mapping is None:
+            continue
+        bound = _View(total.node, tuple(mapping.items()))
+        exponential = bound.child(info.value)
+        if exponential.node.kind != "exp" or not _all_rows(
+            bound, info, logits.axes()
+        ):
+            continue
+        difference = exponential.args()[0]
+        if difference.node.kind != "-":
+            continue
+        values, shifted_maximum = difference.args()
+        if not _bound_same(values, logits, rows):
+            continue
+        original_max = shifted_maximum.node.reduction
+        if original_max is None or original_max.kind != "max":
+            continue
+        max_mapping = _bind_reduction(shifted_maximum, (feature,))
+        if max_mapping is None:
+            continue
+        max_view = _View(shifted_maximum.node, tuple(max_mapping.items()))
+        if not _bound_same(
+            max_view.child(original_max.value), logits, rows
+        ) or not _all_rows(max_view, original_max, logits.axes()):
+            continue
+        # SQL can take MAX of an already grouped, constant maximum again.
+        outer = maximum.node.reduction
+        if (
+            outer is not None
+            and outer.kind == "max"
+            and set(maximum.axes(outer.value.axes)).issubset(rows)
+        ):
+            if not _all_rows(maximum, outer, maximum.axes(outer.row_axes)):
+                continue
+            maximum = maximum.child(outer.value)
+        if not _bound_same(maximum, shifted_maximum, rows):
+            continue
+        if set(bound.axes(info.kept)) != set(rows) or set(
+            bound.axes(info.row_axes)
+        ) != set(logits.axes()):
+            continue
+        return _CrossEntropy(
+            logits, indexes, target.axes(replacement), feature, root.axes()
+        )
+    return None
